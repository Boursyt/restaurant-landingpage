kind: pipeline
name: hugo-website

trigger:
  branch:
    - master
  event:
    - push

steps:
  - name: hugo-build
    image: peaceiris/hugo:v0.65.3-mod
    environment:
      # Use the HTTP website URL for building the site.
      BUCKET_URL:
        from_secret: bucket_url
    commands:
      # This command correctly uses the full website URL.
      - hugo --baseURL $BUCKET_URL
    when:
      event:
        - push      

  - name: deploy-to-s3
    image: amazon/aws-cli
    environment:
      AWS_ACCESS_KEY_ID:
        from_secret: aws_access_key_id
      AWS_SECRET_ACCESS_KEY:
        from_secret: aws_secret_access_key
      AWS_SESSION_TOKEN:
        from_secret: aws_session_token
      AWS_DEFAULT_REGION:
        from_secret: aws_region
      S3_URI:
        from_secret: s3_uri
    commands:
      # Add this line to debug
      - echo "Deploying to $S3_URI in region $AWS_DEFAULT_REGION"
      - aws s3 sync ./public $S3_URI --delete --exact-timestamps
    when:
      event:
        - push
      branch:
        - master

